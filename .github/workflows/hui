name: Build Voicechat JAR
on:
  workflow_dispatch:
  push:
    branches:
      - 26.3

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v3

      - name: Build Bukkit JAR
        run: ./gradlew :bukkit:shadowJar

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: voicechat-bukkit-jar
          path: bukkit/build/libs/*.jar
